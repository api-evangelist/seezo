{
  "issuer": "https://app.seezo.io",
  "authorization_endpoint": "https://app.seezo.io/oauth/authorize",
  "token_endpoint": "https://app.seezo.io/oauth/token/",
  "revocation_endpoint": "https://app.seezo.io/oauth/revoke_token/",
  "registration_endpoint": "https://app.seezo.io/oauth/register/",
